# =============================================================================
# MT5 口座設定テンプレート
# =============================================================================
# このファイルをコピーして .env.<口座名> として保存する。
# 例: .env.icmarkets / .env.titanfx / .env.xm
#
# その後 accounts.conf に口座を追記すれば start-relays.bat で自動起動される。
# =============================================================================

# このリレーが待ち受けるポート番号（口座ごとに別番号を使うこと）
# 例: ICMarkets=5580, TitanFX=5581, XM=5582 ...
MT5_ZMQ_PORT=5580

# MT5 ログイン情報
MT5_LOGIN=ログイン番号（数字）
MT5_PASSWORD=パスワード
MT5_SERVER=サーバー名（例: ICMarketsEU-Live01 / TitanFX-01）

# MT5 インストールパス（複数MT5を使い分ける場合に指定。通常は省略可）
# MT5_TERMINAL_PATH=C:\Program Files\MetaTrader 5

# ポータブル起動（/portable 付きショートカット）の端末なら true。
# 本環境の MQ\ 配下の端末は全てポータブル起動なので既定は true。
# false/未設定だと AppData\Roaming\MetaQuotes\Terminal\<hash> 側の別プロファイルに
# 繋がり、EA・ログ・MQL5\Files が全て別物になる（口座番号では判別できない）。
MT5_PORTABLE=true
